# Both images MUST be supplied by reviewed immutable digest. Build with the
# repository root as context; only dependency manifests are copied from it.
ARG GO_IMAGE
ARG AGENT_IMAGE
FROM ${GO_IMAGE} AS toolchain
FROM ${AGENT_IMAGE}
USER 0:0
RUN apt-get update && apt-get install -y --no-install-recommends git make gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
RUN ln -s /usr/local/go/bin/go /usr/local/bin/go && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt
COPY go.mod go.sum /opt/commonroom/modules/
RUN cd /opt/commonroom/modules && GOMODCACHE=/opt/commonroom/go-modules go mod download \
 && chmod -R a+rX /opt/commonroom/go-modules
COPY docker/agent/entrypoint.cjs docker/agent/workspace.cjs /opt/commonroom/
RUN chmod 0755 /opt/commonroom && chmod 0644 /opt/commonroom/*.cjs
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/commonroom/entrypoint.cjs"]
