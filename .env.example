# Documentation only: the server does not automatically load this file.
# Export these values in your shell; do not commit actual credentials.
DATABASE_URL=postgres://commonroom_runtime@localhost:5432/commonroom?sslmode=disable
# For an explicit --migrate invocation only; never export to the serving process.
# MIGRATION_DATABASE_URL=postgres://commonroom_migrator@localhost:5432/commonroom?sslmode=disable
LISTEN_ADDR=127.0.0.1:8787
OWNER_KEY_FILE=.data/owner-key

# Optional UI feature flag; restart the server after changing.
COMMONROOM_CONNECTION_EDITOR=true
COMMONROOM_WORKFLOW_TEMPLATES=true
COMMONROOM_AGENT_SAFETY_UI=true

# Mandatory Linux/rootless-Docker execution; no isolation off switch.
# Supply a real reviewed image digest; this placeholder blocks launches.
COMMONROOM_AGENT_IMAGE=your-registry/commonroom-agent@sha256:REPLACE_WITH_REVIEWED_DIGEST
COMMONROOM_AGENT_AUTH_DIR=.data/agent-auth

# Keep unexpired human sessions across server restarts without storing PEM keys.
# Disabling removes the private saved session store; authentication stays required.
COMMONROOM_PERSISTENT_SESSIONS=true

# Operator-only development workspace flag; defaults false. Restart required.
# Worker must independently approve each room and bundle; isolation stays mandatory.
# Configuration alone does not unlock repository development; production admission
# and live acceptance are still pending. See docs/release-readiness.md.
COMMONROOM_DEVELOPMENT_WORKSPACES=false
COMMONROOM_DEVELOPMENT_REPOSITORIES={}

# Worker-only, operator-controlled opt-in; defaults false, restart workers.
# Also requires an explicitly admitted command grant; public dispatch stays gated.
# Drain existing sessions before disabling. See docs/isolated-commands.md.
COMMONROOM_ISOLATED_COMMANDS=false
