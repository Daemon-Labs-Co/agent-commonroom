# Copy outside Git to ~/.config/commonroom/runtime.env and chmod 600.
# Use the restricted runtime login, never the database owner.
DATABASE_URL=postgresql://commonroom_runtime@localhost:5432/commonroom
LISTEN_ADDR=127.0.0.1:8787
# Optional exact HTTPS origin. Empty/unset retains local-only browser access.
COMMONROOM_PUBLIC_ORIGIN=https://agentcommonroom.home.arpa

# First-owner setup: after starting, run `commonroom --setup-link` on the server and give
# the owner the link. Optional: a host provisioning many installations may supply the code
# (64 lowercase hex characters, e.g. openssl rand -hex 32) and send
# https://<address>/#setup=<code>. It works once and expires after the lifetime below.
# Leave unset to use the generated private file.
# COMMONROOM_SETUP_CODE=
# COMMONROOM_SETUP_CODE_TTL_HOURS=24

# Run the constrained isolated worker on the application machine. Default false.
# Requires private ~/.config/commonroom-worker/config.json and a local pinned image.
# Keep COMMONROOM_REMOTE_WORKER=false when this is true. Restart after changes.
COMMONROOM_SERVER_WORKER=false
COMMONROOM_REMOTE_WORKER=false

# Set true only when COMMONROOM_REMOTE_WORKER_ALIAS names a worker account on THIS
# machine; the server card's endpoints then use that account. Default false.
# Requires COMMONROOM_REMOTE_WORKER=true and COMMONROOM_SERVER_WORKER=false.
COMMONROOM_SERVER_ENDPOINT_VIA_ALIAS=false

# Hosting many workspaces (ADR 0004/0005). Default is one workspace, unchanged. Requires
# migrations 002 and 003, wildcard DNS and a wildcard HTTPS certificate for the domain, and
# the proxy forwarding the original Host. COMMONROOM_PUBLIC_ORIGIN must be unset in multi mode.
# COMMONROOM_TENANCY=multi
# COMMONROOM_WORKSPACE_DOMAIN=rooms.example.com

# Optional single sign-on through one OpenID Connect provider (ADR 0006). The issuer must be
# an https URL with a DNS host name. Register the redirect URI <workspace origin>/api/oidc/callback
# with the provider (for hosted workspaces: https://*.rooms.example.com/api/oidc/callback if it allows
# wildcards). Prefer the secret file (private, mode 600) over the environment variable.
# COMMONROOM_OIDC_ISSUER=https://idp.example.com
# COMMONROOM_OIDC_CLIENT_ID=
# COMMONROOM_OIDC_CLIENT_SECRET_FILE=/home/you/.config/commonroom/oidc-secret
# COMMONROOM_OIDC_NAME=Single sign-on

# Hosted agent execution (multi mode only). Off by default. When true, startup requires an isolated
# worker (COMMONROOM_REMOTE_WORKER or COMMONROOM_SERVER_WORKER) and refuses to start while
# COMMONROOM_DEVELOPMENT_WORKSPACES, COMMONROOM_ISOLATED_COMMANDS or COMMONROOM_WORKER_DEVELOPMENT
# are enabled. Agents are chat-only. Verify on a staging installation before enabling.
# COMMONROOM_HOSTED_EXECUTION=true
# Most agent turns running at once across all workspaces (1-256, default 8).
# COMMONROOM_HOSTED_MAX_TURNS=8
