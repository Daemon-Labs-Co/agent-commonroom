# Copy outside Git to ~/.config/commonroom/runtime.env and chmod 600.
# Use the restricted runtime login, never the database owner.
DATABASE_URL=postgresql://commonroom_runtime@localhost:5432/commonroom
LISTEN_ADDR=127.0.0.1:8787
# Optional exact HTTPS origin. Empty/unset retains local-only browser access.
COMMONROOM_PUBLIC_ORIGIN=https://agentcommonroom.home.arpa

# Run the constrained isolated worker on the application machine. Default false.
# Requires private ~/.config/commonroom-worker/config.json and a local pinned image.
# Keep COMMONROOM_REMOTE_WORKER=false when this is true. Restart after changes.
COMMONROOM_SERVER_WORKER=false
COMMONROOM_REMOTE_WORKER=false

# Set true only when COMMONROOM_REMOTE_WORKER_ALIAS names a worker account on THIS
# machine; the server card's endpoints then use that account. Default false.
# Requires COMMONROOM_REMOTE_WORKER=true and COMMONROOM_SERVER_WORKER=false.
COMMONROOM_SERVER_ENDPOINT_VIA_ALIAS=false
